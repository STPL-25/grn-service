# ── Service ──────────────────────────────────────────────
PORT=8084
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── MSSQL (same DB as the monolith) ──────────────────────
DB_USER=admin
DB_USER_PASSWORD=admin123
SERVER=10.0.21.8
DATABASE=Non_Trade
DB_PORT=1433
DB_POOL_MAX=20
DB_POOL_MIN=2

# ── Redis (shared with the monolith — grn:* namespace) ───
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Auth: MUST match the monolith's JWT_SECRET ───────────
JWT_SECRET='YzNCaFkyVm5jbTkxY0c5bVkyOXRjR0Z1YVdWeg=='

# ── Dev-only: static bearer token for Postman testing ────
DEV_BYPASS_TOKEN=dev-postman-2026
DEV_BYPASS_ECNO=DEV001

# ── FTP (same server the monolith backend uses for uploads) ─
# FTP_HOST=10.0.222.102
# FTP_USER=1148
# FTP_PASS=

# Public URL of the monolith backend — it owns the /dwl download route
# (backend/src/Utils/ImagesUpload/imageRoute.js), grn-service does not.
# Uploaded photo URLs are built against this, not this service's own port.
BACKEND_PUBLIC_URL=http://localhost:8081

# ── Supplier portal ───────────────────────────────────────
# Dev-only: static bearer token for Postman testing (supplier endpoints)
SUPPLIER_DEV_BYPASS_TOKEN=dev-supplier-postman-2026
# Frontend URL the supplier invite email links to
SUPPLIER_PORTAL_URL=http://localhost:5173/supplier

# ── SMTP (supplier invite emails) — without these set, invites are
# logged to the console instead of sent, see src/utils/mailer.js ─
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
