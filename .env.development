# ── Service ──────────────────────────────────────────────
PORT=8084
NODE_ENV=development
# CLIENT_URL: frontend origin(s) for CORS (comma-separated allowed)
# development:
CLIENT_URL=http://localhost:5173
# production:
# CLIENT_URL=https://uatfront.spacetextiles.net

# ── MSSQL (same DB as the monolith) ──────────────────────
DB_USER=admin
DB_USER_PASSWORD=admin123
SERVER=10.0.21.8
DATABASE=Non_Trade
DB_PORT=1433
DB_POOL_MAX=20
DB_POOL_MIN=2

# ── Redis (shared with the monolith — grn:* namespace) ───
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Auth: MUST match the monolith's JWT_SECRET ───────────
JWT_SECRET='YzNCaFkyVm5jbTkxY0c5bVkyOXRjR0Z1YVdWeg=='

# ── Dev-only: static bearer token for Postman testing ────
DEV_BYPASS_TOKEN=dev-postman-2026
DEV_BYPASS_ECNO=DEV001

# ── Monolith backend public URL (owns the /dwl download route) ──
# development:
BACKEND_PUBLIC_URL=http://localhost:8081
# production:
# BACKEND_PUBLIC_URL=https://uatback.spacetextiles.net
# BACKEND_PUBLIC_URL=http://10.0.20.4:8081

# Must match the monolith's INTERNAL_BROADCAST_SECRET exactly.
INTERNAL_BROADCAST_SECRET=tGUunoOAMbprW76BPwsbjJPBevuyEcOesG5uJj2Jky0=

# ── Supplier portal ───────────────────────────────────────
SUPPLIER_DEV_BYPASS_TOKEN=dev-supplier-postman-2026
# development:
SUPPLIER_PORTAL_URL=http://localhost:5173/supplier
# production:
# SUPPLIER_PORTAL_URL=https://uatfront.spacetextiles.net/supplier

# SMTP (supplier invite emails via Gmail) — see src/utils/mailer.js
# SMTP moved to notification-service — this service no longer sends email
# directly, it calls notification-service's /api/notify/email/* instead.
NOTIFICATION_SERVICE_URL=http://localhost:8086
