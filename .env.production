DB_USER_PASSWORD=admin123
SERVER=10.0.21.8
DATABASE=Non_Trade
DB_PORT=1433
DB_POOL_MAX=20
DB_POOL_MIN=2

# ── Redis (shared with the monolith — grn:* namespace) ───
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Auth: MUST match the monolith's JWT_SECRET ───────────
JWT_SECRET='YzNCaFkyVm5jbTkxY0c5bVkyOXRjR0Z1YVdWeg=='

# Dev bypass tokens intentionally NOT set in production
